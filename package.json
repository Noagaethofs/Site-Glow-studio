{
  "name": "glow-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site de GLOW — agence créative et digitale belge. Designed to Shine.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "lint:html": "vite build && html-validate \"dist/**/*.html\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.2"
  }
}
